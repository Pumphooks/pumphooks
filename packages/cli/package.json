{
  "name": "@pump-hooks/cli",
  "version": "0.1.0",
  "description": "pump-hooks / pumphooks: Pump market commands, and developer commands for ABI v1 program hooks (init, build, test, simulate, bench, security-check, deploy, register).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pump-hooks": "./dist/bin.js",
    "pumphooks": "./dist/pumphooks.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@pump-hooks/sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "@pump-hooks/hook-analyzer": "workspace:*",
    "@pump-hooks/hook-bench": "workspace:*",
    "@pump-hooks/hook-security": "workspace:*",
    "@pump-hooks/execution-lab": "workspace:*",
    "@pump-hooks/demos": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "litesvm": "0.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
