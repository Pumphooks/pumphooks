{
  "name": "@pump-hooks/transaction-compiler",
  "version": "0.1.0",
  "description": "Compiles Pump Hooks operations into one atomic Solana transaction (or an explicit error): dependency ordering, merged account metas, required signers, exact size, address lookup tables, compute budget, and simulation against the compiled programs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pump-hooks/execution-lab": "workspace:*",
    "@pump-hooks/sdk": "workspace:*",
    "@solana/kit": "^8.0.0"
  },
  "devDependencies": {
    "@pump-hooks/hook-security": "workspace:*",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
